{
  "name": "app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "concurrently -n server,android -c blue,green --kill-others-on-fail --passthrough-arguments \"npm run dev --prefix ../server\" \"react-native run-android {@}\" --",
    "android:app-only": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "e2e:build": "detox build --configuration android.emu.debug",
    "e2e:test": "npm run db:test:migrate --prefix ../server && concurrently -n server,detox -c blue,green --kill-others --success first \"npm run dev:test --prefix ../server\" \"detox test --configuration android.emu.debug\"",
    "e2e:test:5554": "npm run db:test:migrate --prefix ../server && concurrently -n server,detox -c blue,green --kill-others --success first --passthrough-arguments \"npm run dev:test --prefix ../server\" \"detox test --configuration android.att.debug --device-name emulator-5554 {@}\" --"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sayem314/react-native-keep-awake": "^2.0.0",
    "@tanstack/react-query": "^5.103.2",
    "react": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "0.87.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-launch-arguments": "^4.1.1",
    "react-native-purchases": "^10.10.2",
    "react-native-purchases-ui": "^10.10.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "concurrently": "^10.0.5",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "test-renderer": "~1.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
