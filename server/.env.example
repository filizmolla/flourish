PORT=3000
DATABASE_URL="postgresql://flourish_app:changeme@localhost:5432/flourish?schema=public"
BETTER_AUTH_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
BETTER_AUTH_URL="http://localhost:3000"

# Photo import: any OpenAI-compatible chat-completions endpoint with image input.
# Gemini free tier: https://generativelanguage.googleapis.com/v1beta/openai/ (key from Google AI Studio)
# Ollama later: http://localhost:11434/v1/ (no key needed)
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY=""
LLM_MODEL="gemini-3.8-flash"
# Optional, Gemini only: minimal / low / medium / high. "low" cuts the slowest
# 10% of reads from ~17 s to ~4 s (fixture set, 2026-09-28). Leave empty for Ollama.
LLM_REASONING_EFFORT="low"

# Photo import: where import photos are kept (imports/{userId}/{importId}/{position}.jpg).
# Relative to server/; never inside a public/static folder. .env.test and .env.demo use their own folders.
STORAGE_DIR="./storage"
